{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "Một yêu cầu streaming từ đầu đến cuối",
    "subtitle": "Từ câu hỏi của sinh viên đến câu trả lời có citation",
    "output": "request-lifecycle.html",
    "viewBox": [1080, 610],
    "column_fit": "spread",
    "animation": "trace",
    "quality_profile": "showcase",
    "views": [
      {"id": "plan", "label": "Lập kế hoạch", "focus": ["client", "api", "pipeline", "router"], "note": "Chuẩn hóa câu hỏi và tạo QueryPlan có schema."},
      {"id": "evidence", "label": "Thu thập evidence", "focus": ["pipeline", "executor", "stores"], "note": "Thực thi từng task rồi tổng hợp dữ kiện và citation."},
      {"id": "compose", "label": "Cache và soạn đáp án", "focus": ["pipeline", "cache", "composer", "api", "client"], "note": "Cache bị ràng buộc bởi evidence; cache miss mới gọi composer."}
    ]
  },
  "participants": [
    {"id": "client", "type": "frontend", "label": "React client", "sublabel": "chat UI"},
    {"id": "api", "type": "backend", "label": "FastAPI", "sublabel": "/chat/stream"},
    {"id": "pipeline", "type": "backend", "label": "AnswerPipeline", "sublabel": "answer_stream"},
    {"id": "router", "type": "external", "label": "AI Router", "sublabel": "typed planner"},
    {"id": "executor", "type": "backend", "label": "PlanExecutor", "sublabel": "task runner"},
    {"id": "stores", "type": "database", "label": "Evidence stores", "sublabel": "tables + hybrid RAG"},
    {"id": "cache", "type": "database", "label": "Response cache", "sublabel": "evidence-bound"},
    {"id": "composer", "type": "external", "label": "Gemini composer", "sublabel": "streaming model"}
  ],
  "segments": [
    {"from": 150, "to": 275, "label": "Request + plan"},
    {"from": 280, "to": 390, "label": "Task execution"},
    {"from": 395, "to": 535, "label": "Cache + response"}
  ],
  "messages": [
    {"id": "ask", "from": "client", "to": "api", "y": 165, "label": "question + cohort + history", "variant": "emphasis"},
    {"id": "start", "from": "api", "to": "pipeline", "y": 195, "label": "answer_stream(request)", "variant": "emphasis"},
    {"id": "plan", "from": "pipeline", "to": "router", "y": 225, "label": "plan normalized query", "variant": "default"},
    {"id": "query-plan", "from": "router", "to": "pipeline", "y": 255, "label": "validated QueryPlan", "variant": "return"},
    {"id": "execute", "from": "pipeline", "to": "executor", "y": 285, "label": "execute tasks in order", "variant": "emphasis"},
    {"id": "lookup", "from": "executor", "to": "stores", "y": 315, "label": "structured lookup or RAG", "variant": "default"},
    {"id": "evidence", "from": "stores", "to": "executor", "y": 345, "label": "facts + parents + citations", "variant": "return"},
    {"id": "aggregate", "from": "executor", "to": "pipeline", "y": 375, "label": "aggregated evidence", "variant": "return"},
    {"id": "cache-read", "from": "pipeline", "to": "cache", "y": 405, "label": "evidence key: cache miss", "variant": "dashed"},
    {"id": "compose", "from": "pipeline", "to": "composer", "y": 435, "label": "grounded evidence packet", "variant": "emphasis"},
    {"id": "chunks", "from": "composer", "to": "pipeline", "y": 465, "label": "text chunks", "variant": "return"},
    {"id": "done", "from": "pipeline", "to": "api", "y": 495, "label": "metadata + tokens + done", "variant": "return"},
    {"id": "done-sse", "from": "api", "to": "client", "y": 525, "label": "SSE metadata + token + done", "variant": "return"}
  ],
  "activations": [
    {"participant": "api", "from": 160, "to": 533, "type": "backend"},
    {"participant": "pipeline", "from": 190, "to": 503, "type": "backend"},
    {"participant": "router", "from": 220, "to": 260, "type": "external"},
    {"participant": "executor", "from": 280, "to": 380, "type": "backend"},
    {"participant": "stores", "from": 310, "to": 350, "type": "database"},
    {"participant": "cache", "from": 400, "to": 425, "type": "database"},
    {"participant": "composer", "from": 430, "to": 470, "type": "external"}
  ]
}
