# Answer generation
GEMINI_API_KEYS=gemini_key_1,gemini_key_2

# Groq Router and evaluation Judge
GROQ_API_KEYS=groq_key_1,groq_key_2
# GROQ_ROUTER_API_KEYS=router_key_1,router_key_2

# Router overrides
STUDENT_RAG_ROUTER_MODEL=qwen/qwen3.8-27b
STUDENT_RAG_ROUTER_REASONING_EFFORT=low
STUDENT_RAG_ROUTER_MAX_OUTPUT_TOKENS=768
# STUDENT_RAG_ROUTER_HARD_MAX_OUTPUT_TOKENS=2048
STUDENT_RAG_ROUTER_RESPONSE_FORMAT=json_schema
STUDENT_RAG_ROUTER_WAIT_WHEN_LIMITED=false

# API and runtime controls
STUDENT_RAG_API_BASE_URL=http://127.0.0.1:8000
STUDENT_RAG_EXECUTION_MODE=API
STUDENT_RAG_SHOW_DEBUG=false
STUDENT_RAG_MAX_QUERY_CHARS=500
# Per anonymous browser installation; API clients without X-Client-ID fall back to IP.
STUDENT_RAG_RATE_LIMIT_PER_MINUTE=20
# Broad abuse guard shared by clients behind the same public IP.
STUDENT_RAG_IP_RATE_LIMIT_PER_MINUTE=120
STUDENT_RAG_MAX_CONCURRENT_CHAT=3
STUDENT_RAG_MAX_QUEUE_SIZE=10
STUDENT_RAG_QUEUE_TIMEOUT_SECONDS=15
STUDENT_RAG_READINESS_PROBE_TIMEOUT_MS=1500
STUDENT_RAG_READINESS_CACHE_SECONDS=30

# Qdrant regulation collection
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=your_qdrant_key
QDRANT_COLLECTION_NAME=student_handbook_semantic_v32
QDRANT_CREATE_PAYLOAD_INDEXES=false
# Production retrieval contract. Non-default ablations require an explicit
# STUDENT_RAG_ALLOW_RETRIEVAL_ABLATION=true guard.
STUDENT_RAG_RETRIEVAL_CONFIG=configs/retrieval.yaml
STUDENT_RAG_RETRIEVAL_MODE=vector_primary_graph_supplement

# MongoDB parent sections
MONGODB_URL=mongodb+srv://...
MONGODB_DB_NAME=chatbotHCMUE
MONGODB_PARENT_COLLECTION=parent_docs_v32
MONGODB_PARENT_LOOKUP_ENABLED=true
MONGODB_TIMEOUT_MS=3000
MONGODB_FAILURE_BACKOFF_SECONDS=300

# Redis-backed cache, rate-limit state, and lightweight metrics
REDIS_URL=rediss://...
# STUDENT_RAG_DISABLE_REDIS=false
# STUDENT_RAG_REQUIRE_REDIS=true
# Offset added to Redis visit counter so production can keep continuity after migration.
STUDENT_RAG_VISIT_COUNT_OFFSET=150

# Optional LangSmith observability (QueryPlan/task/cohort tracing)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_pt_...
LANGSMITH_PROJECT=hcmue-student-handbook-rag
# Legacy LANGCHAIN_API_KEY / LANGCHAIN_PROJECT names are also accepted.

# Optional evaluation/debug telemetry
STUDENT_RAG_EVAL_TELEMETRY=false
ANONYMIZED_TELEMETRY=false
