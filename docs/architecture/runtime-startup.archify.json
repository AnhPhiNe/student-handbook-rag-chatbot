{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "Container startup, warm-up và readiness",
    "subtitle": "Port mở trước; model và BM25 khởi tạo trên background thread",
    "output": "runtime-startup.html",
    "viewBox": [1080, 580],
    "column_fit": "spread",
    "animation": "trace",
    "quality_profile": "showcase",
    "views": [
      {"id": "boot", "label": "Boot không chặn port", "focus": ["platform", "uvicorn", "lifespan", "health"], "note": "Liveness hoạt động ngay cả khi warm-up vẫn đang chạy."},
      {"id": "warmup", "label": "Background warm-up", "focus": ["lifespan", "warmup", "assets", "retriever"], "note": "Embedding, catalogs, clients và hybrid retriever được dựng ngoài startup path."},
      {"id": "readiness", "label": "Readiness và degraded mode", "focus": ["retriever", "health", "platform"], "note": "BM25 fail-open; readiness vẫn báo rõ trạng thái Qdrant, MongoDB và artifacts."}
    ]
  },
  "participants": [
    {"id": "platform", "type": "external", "label": "Hosting platform", "sublabel": "container probe"},
    {"id": "uvicorn", "type": "backend", "label": "Uvicorn", "sublabel": "one worker"},
    {"id": "lifespan", "type": "backend", "label": "FastAPI lifespan", "sublabel": "startup hook"},
    {"id": "warmup", "type": "backend", "label": "Warm-up thread", "sublabel": "non-blocking"},
    {"id": "assets", "type": "database", "label": "Models + catalogs", "sublabel": "local artifacts"},
    {"id": "retriever", "type": "backend", "label": "Hybrid retriever", "sublabel": "BM25 state"},
    {"id": "health", "type": "security", "label": "Health routes", "sublabel": "live + ready"}
  ],
  "segments": [
    {"from": 150, "to": 260, "label": "Port first"},
    {"from": 265, "to": 410, "label": "Background warm-up"},
