# ======== VERCEL PRODUCTION CONFIGURATION ========
# Define the API URL pointing to the Hugging Face Space
VITE_API_BASE_URL=https://anhfeee-hcmue-handbook-rag-api.hf.space

# Optional: server-side Vercel /api/visits proxy target. Defaults to VITE_API_BASE_URL.
VISITOR_API_BASE_URL=https://anhfeee-hcmue-handbook-rag-api.hf.space

# Optional: lets the status badge read the Hugging Face Space runtime stage
VITE_HF_SPACE_ID=AnhFeee/hcmue-handbook-rag-api

# Bật (true) hoặc tắt (false) chế độ bảo trì tính năng Chat AI (mặc định: false)
VITE_CHAT_MAINTENANCE=false
